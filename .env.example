# Serviços no Bairro — variáveis de ambiente
# O projeto ATUAL não lê nenhuma variável de ambiente (nenhum `import.meta.env`
# customizado existe no código). Tudo é estático em arquivos TypeScript.
# As chaves abaixo só serão necessárias SE, após a migração, forem adicionados
# banco de dados, formulários com backend ou analytics.

# --- Build / SEO (usado hoje apenas como constante hardcoded) ---
# Hoje o domínio está fixo em: src/hooks/useSEO.ts (SITE_URL) e scripts/generate-sitemap.ts (BASE_URL)
VITE_SITE_URL=

# --- Banco de dados (NÃO utilizado hoje) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- API/backend próprio (NÃO utilizado hoje) ---
# API_URL=

# --- Analytics / verificação (hoje hardcoded em index.html) ---
# GOOGLE_SITE_VERIFICATION=
